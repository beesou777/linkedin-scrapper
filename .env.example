# LinkedIn Authentication Cookie
# Get this from your browser:
# 1. Login to LinkedIn in your browser
# 2. Open DevTools (F12) â†’ Application â†’ Cookies â†’ https://www.linkedin.com
# 3. Find 'li_at' cookie and copy its entire value
LI_AT_COOKIE=your_linkedin_cookie_value_here

# PostgreSQL Database Connection URL
# Format: postgresql://user:password@host:port/database
# Required for uploading scraped jobs to database
DATABASE_URL=postgresql://postgres.user:password@host:6543/postgres

# Optional: Maximum number of jobs to scrape (default: 10000)
# The scraper will automatically stop when no more jobs are available
# Set to a lower number if you want to limit scraping for testing
# MAX_JOBS=5000
